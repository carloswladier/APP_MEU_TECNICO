# ==============================================================================
# CONFIGURAÇÕES E CHAVES DE SEGURANÇA (AI STUDIO SECRETS)
# ==============================================================================
# Para configurar credenciais seguras sem expor senhas no código,
# utilize o painel "Secrets" no menu lateral do Google AI Studio.
# ==============================================================================

# GITHUB_TOKEN: Token de Acesso Pessoal do GitHub (Classic Token com escopo 'repo').
# Necessário apenas se o repositório for PRIVADO.
GITHUB_TOKEN=not_set

# GITHUB_OWNER: Proprietário ou usuário do GitHub que contém os arquivos
GITHUB_OWNER=carloswladier

# GITHUB_REPO: Nome do repositório no GitHub (ex: indicadores-claro)
GITHUB_REPO=indicadores-claro

# GITHUB_BRANCH: Nome da branch onde estão as planilhas (padrão: main)
GITHUB_BRANCH=main

# GITHUB_FOLDER: Subpasta dentro do repositório onde os arquivos estão salvos (ex: planilhas)
GITHUB_FOLDER=default

# HOSTINGER_API_URL: Endereço completo do script PHP de sincronização com o banco MySQL na Hostinger
HOSTINGER_API_URL=https://seusite.com.br/api/indicadores_api.php

# HOSTINGER_API_KEY: Chave secreta de autenticação do endpoint PHP na Hostinger
HOSTINGER_API_KEY=claro_indicadores_sec_2026
